PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/cafevibes
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=CafeVibes <noreply@cafevibes.com>
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Initial Admin Provisioning (Optional - securely created on first boot if no admin exists)
INITIAL_ADMIN_EMAIL=admin@yourcafe.com
INITIAL_ADMIN_PASSWORD=your_secure_admin_password_min_8_chars
INITIAL_ADMIN_NAME=CafeVibes Admin

# Database Seeding Protection Secret (Required if invoking /api/seed in production)
ADMIN_SEED_SECRET=your_seed_endpoint_protection_secret
