# ==========================================
# CafeVibes - Vercel & Production Environment
# ==========================================

# Database (Required) - e.g. MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/cafevibes?retryWrites=true&w=majority

# JWT Authentication (Required)
JWT_SECRET=super_secret_jwt_key_please_change_in_production
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_please_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Environment & URL (Optional)
NODE_ENV=production
CLIENT_URL=https://your-cafevibes-deployment.vercel.app

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://your-cafevibes-deployment.vercel.app/api/auth/google/callback

# Email Receipts / Nodemailer (Optional)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Frontend Config (Optional - automatically defaults to /api when deployed on Vercel)
# VITE_API_URL=/api
# VITE_SOCKET_URL=https://your-separate-socket-server.onrender.com
